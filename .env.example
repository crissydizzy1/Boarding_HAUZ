# Copy this file to .env and fill in values for your local environment.
BOARDING_HAUZ_DB_HOST=127.0.0.1
BOARDING_HAUZ_DB_PORT=3306
BOARDING_HAUZ_DB_NAME=boarding_hauz
BOARDING_HAUZ_DB_USER=boarding_hauz_app
BOARDING_HAUZ_DB_PASSWORD=change-this-password
BOARDING_HAUZ_DB_SSL=0
# Optional CA certificate path when your database provider requires verified TLS.
# BOARDING_HAUZ_DB_SSL_CA=/path/to/ca.pem
